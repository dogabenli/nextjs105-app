# Auth0 configuration (Milestone 3 - interactive login + server-side session).
#
# This project uses @auth0/nextjs-auth0 v4 (the only major version compatible with
# this app's Next.js 16 / React 19). Variable names differ from the v3 SDK:
#   AUTH0_BASE_URL        -> APP_BASE_URL
#   AUTH0_ISSUER_BASE_URL -> AUTH0_DOMAIN (no https:// scheme)
# AUTH0_AUDIENCE and AUTH0_SCOPE are not native v4 variables; this app reads them
# itself in src/lib/auth0.ts to configure authorizationParameters.
#
# Never commit a real .env.local with actual secrets.

AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=YOUR_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://sitecore-member-poc-api
AUTH0_SCOPE=openid profile email

# On-demand ISR (Milestone 7 - see docs/member-poc/02-milestones.md).
# Required by POST /api/revalidate, sent in the `x-revalidate-secret` request header.
# The endpoint fails closed (401) when this is unset - never leave it empty outside dev.
REVALIDATE_SECRET=
