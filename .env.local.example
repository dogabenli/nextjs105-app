# Local-only overrides (gitignored). See .env for documentation of each variable.

# Force relative asset URLs in local dev instead of the http://localhost:3000 default.
# Without this, assetPrefix stays pinned to localhost:3000, so the webpack-hmr dev
# websocket tries to connect to ws://localhost:3000 even when you browse via
# en.nextjs105.local/da.nextjs105.local. That connection gets rejected (different
# host), the client hits WEB_SOCKET_MAX_RECONNECTIONS, and calls window.location.reload(),
# which repeats forever - the infinite refresh loop you're seeing.
PUBLIC_URL=
