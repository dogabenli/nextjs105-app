<!--
  On-demand ISR webhook secret (Milestone 7 optional follow-up).

  This setting is consumed by a CM-only publish pipeline processor (implemented in your
  Sitecore .NET solution, not in this repo) that calls POST /api/revalidate after publish.
  It must exactly match the Next.js REVALIDATE_SECRET value (see .env.example) - treat both
  as the same secret, not two independent ones.

  Deploy this file only to CM instances. Do not deploy it to CD - CD never calls this endpoint.
  Replace the placeholder value via a protected/environment-specific config layer; never commit
  a real secret to source control.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/">
  <sitecore role:require="Standalone or ContentManagement">
    <settings>
      <setting name="NextJs105App.Revalidate.Secret" value="53g08m2shhlo3eryirto9dcvj9uvigpmfmom9xuxvk" />
      <setting name="NextJs105App.Revalidate.EndpointUrl" value="http://localhost:3000/api/revalidate" />
    </settings>
  </sitecore>
</configuration>
